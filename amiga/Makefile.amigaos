# GNUjump for AmigaOS 3.x / AmiCradle, 68040 + FPU, on acsdl12.
#
#   make -f amiga/Makefile.amigaos STOVE=/path/to/os32-gcc16/prefix \
#        NDK=/path/to/gfopensdk/OpenNDK/Include_H \
#        ACSDL=/path/to/amicradle-guest/gameports/acsdl12 \
#        ACSDLLIB=/path/to/acsdl12/build ACGAME=/path/to/acgame \
#        ACGAMELIB=/path/to/acgame/build-amiga
#
# STOVE is GFOpenAmigaGCC 16.2.0-open4 or later. ACSDL is acsdl12, built with
# its own Makefile.amigaos (it holds zlib's inflate for the PNGs; nothing
# here needs ZLIB, which is kept for the ports' common command line).
# The software renderer only: amiga/gl2d_none.c stands in for SDL_2dgl.c.
# The skins are amiga/skins (made from skins by amiga/tools/skin8.py, in
# 256 colours a skin) and the sounds amiga/sound (the Ogg sounds as WAVs).
# acsdl12 is built with ACG= into ACSDLLIB, without its own copy of ACGame:
# the game gets ACGame from acgame.library, through ACGAMELIB's libacgame.a
# (DalsinAI/acgame's stubs). package/acgame-deps.sh builds both.
# Output: build/amigaos/GNUjump/ with the program, skins/, sound/, replays/,
# ReadMe and COPYING, their icons, and GNUjump.info beside the drawer.

STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16/prefix
NDK     ?= $(HOME)/AmiCradle/gfopensdk/OpenNDK/Include_H
ACSDL   ?= ../amicradle-guest/gameports/acsdl12
ACSDLLIB ?= $(ACSDL)/build/amigaos
ACGAME  ?= $(ACSDL)/../acgame
ACGAMELIB ?= $(ACGAME)/build-amiga
ZLIB    ?= ../zlib-1.3.1
CC      = $(STOVE)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -m68881
OPT     ?= -O2 -fomit-frame-pointer
CFLAGS  = -noixemul -std=gnu99 $(OPT) $(CPU) -Wall -Wno-unused-but-set-variable \
          -Wno-discarded-qualifiers -DHAVE_CONFIG_H \
          -Iamiga -Isrc -I$(ACSDL)/include -I$(ACSDL)/include/SDL -I$(ACGAME)/include -I$(NDK)
LDFLAGS = -noixemul $(CPU)
BUILD   = build/amigaos
OUT     = $(BUILD)/GNUjump

SRC     = SDL_rotozoom.c SFont.c effects-blur.c effects-trail.c game-input.c \
          game-logic.c game-output.c game-timer.c game-tools.c game.c main.c \
          menu-system.c menu.c records.c replay.c setup.c sprite.c surface.c tools.c
AMIGA   = amiga.c gl2d_none.c stack.c
OBJS    = $(SRC:%.c=$(BUILD)/%.o) $(AMIGA:%.c=$(BUILD)/amiga_%.o)
SKINS   = auri default sdljump wincrash xjump
ICON    = amiga/icons/GNUjump.info

all: $(OUT)/gnujump data

$(OUT)/gnujump: $(OBJS) | $(OUT)
	$(CC) $(LDFLAGS) -o $@ $^ $(ACSDLLIB)/libacsdl12.a $(ACGAMELIB)/libacgame.a -lm

# The data; of its drawers only replays (the player's own) has an icon.
data: | $(OUT)
	rm -rf $(OUT)/skins $(OUT)/sound
	cp -r amiga/skins $(OUT)/skins
	mkdir -p $(OUT)/sound $(OUT)/replays
	cp amiga/sound/*.wav $(OUT)/sound/
	sed -e 's/"silence\.ogg"/"none"/' -e 's/\.ogg"/.wav"/' sound/config.sounds > $(OUT)/sound/config.sounds
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp COPYING $(OUT)/COPYING
	cp amiga/icons/gnujump.info amiga/icons/ReadMe.info amiga/icons/COPYING.info \
	   amiga/icons/replays.info $(OUT)/
	cp $(ICON) $(BUILD)/

$(BUILD)/%.o: src/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/amiga_%.o: amiga/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD) $(OUT):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all data clean
