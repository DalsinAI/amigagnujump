; $VER: Install-GNUjump 1.0.8-amiga1 (6.11.2026)
; The Amiga Installer script for GNUjump, an AmiCradle game port.
; Made by amicradle scripts/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the GNUjump drawer where the archive was unpacked.

(set @app-name "GNUjump")
(set #version "1.0.8-amiga1")
(set #drawer "GNUjump")
(set #program "gnujump")
(set #space 5860)  ; KB

(onerror
    (message (cat "GNUjump was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-GNUjump again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "GNUjump needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "GNUjump needs a 68040, 68060 or 68080 with an FPU. This Amiga has a " #cpu ".")))
(if (= (database "fpu") "NOFPU")
    (abort "GNUjump needs a 68040, 68060 or 68080 with an FPU. This Amiga has no FPU."))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The GNUjump drawer is not beside Install-GNUjump. Unpack the whole archive, then run Install-GNUjump from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The GNUjump drawer has no gnujump in it. Unpack the whole archive again."))

(welcome "This installs GNUjump 1.0.8-amiga1 for AmigaOS 3.2 on a 68040, 68060 or 68080 with an FPU.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the GNUjump drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called GNUjump in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": GNUjump needs 6 MB free.")))

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "replays") (noreq))
    (set #kept (if (= #kept "") "replays" (cat #kept "|" "replays"))))
(if (exists (tackon #dest "gnujump.cfg") (noreq))
    (set #kept (if (= #kept "") "gnujump.cfg" (cat #kept "|" "gnujump.cfg"))))
(if (exists (tackon #dest "gnujump.hsc") (noreq))
    (set #kept (if (= #kept "") "gnujump.hsc" (cat #kept "|" "gnujump.hsc"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying GNUjump")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating GNUjump. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "GNUjump.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "GNUjump.info")))

(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. GNUjump would have gone in " #dest "."))
    (message (cat "GNUjump 1.0.8-amiga1 is installed in " #dest "."
                  "\n\nTo start it, open the GNUjump drawer and double-click the gnujump icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept ".")))))
(exit (quiet))
